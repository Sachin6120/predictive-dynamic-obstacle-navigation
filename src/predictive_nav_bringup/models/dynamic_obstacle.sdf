<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="dynamic_obstacle">
    <!-- Pose is overridden at spawn time via the ros_gz_sim create node; this
         is only the fallback if spawned without an explicit pose. -->
    <pose>-1.0 -0.5 0.3 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="link">
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.15</ixx>
          <iyy>0.15</iyy>
          <izz>0.1</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.15 0.15 1</ambient>
          <diffuse>1.0 0.15 0.15 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <!-- Directly drives the model's planar velocity via
         /model/dynamic_obstacle/cmd_vel (gz.msgs.Twist). This gives an
         exact, known ground-truth command for validating the tracker. -->
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
    </plugin>

    <!-- Publishes ground-truth odometry for this model on
         /model/dynamic_obstacle/odometry (gz.msgs.Odometry), used only for
         quantitative tracker validation, never consumed by the tracker. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>dynamic_obstacle</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
